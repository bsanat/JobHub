APP_ENV=development
PORT=8080
POSTGRES_USER=jobhub
POSTGRES_PASSWORD=jobhub
POSTGRES_DB=jobhub_ats_poc_careers_20260925
POSTGRES_PORT=5432
# Local POC database used by `make dev` and `make backend-dev`.
JOBHUB_POC_DATABASE=jobhub_ats_poc_careers_20260925
DATABASE_URL=postgresql://jobhub:jobhub@localhost:5432/jobhub_ats_poc_careers_20260925?sslmode=disable
DATABASE_MIGRATION_URL=postgresql://jobhub:jobhub@localhost:5432/jobhub_ats_poc_careers_20260925?sslmode=disable

# Frontend (safe to expose in the browser)
VITE_API_URL=http://localhost:8080/api/v1
VITE_USE_MOCKS=true
PGX_QUERY_EXEC_MODE=cache_statement
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_PROXY_TARGET=http://localhost:8080

# Server-side Jooble Kazakhstan proof of concept. Never expose this as VITE_*.
# Production use remains disabled until provider permissions are confirmed.
JOOBLE_API_KEY=
JOOBLE_API_BASE_URL=https://kz.jooble.org/api
JOOBLE_MAX_REQUESTS=10
JOOBLE_RESULTS_PER_PAGE=10
JOOBLE_FRESH_FOR=72h
JOOBLE_SEARCHES='программист|Казахстан;бухгалтер|Казахстан;менеджер по продажам|Казахстан'

# Server-side Telegram vacancy collector. Keep the real token only in local .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHANNEL_IDS=
TELEGRAM_OFFSET_FILE=./storage/telegram-collector.offset
TELEGRAM_DEV_DATABASE_URL=

# Server-side Telegram vacancy publisher. Keep the real token only in local .env.
TELEGRAM_PUBLIC_CHANNEL_ID=
TELEGRAM_PUBLIC_CHANNEL_USERNAME=
TELEGRAM_PUBLISHER_ENABLED=false
TELEGRAM_PUBLISHER_DRY_RUN=true
TELEGRAM_PUBLISH_WITHOUT_LINK=false
TELEGRAM_PUBLISH_TEST_SOURCES=false
TELEGRAM_PUBLISH_TEST_CHANNEL_ID=
TELEGRAM_PUBLISH_INTERVAL=60s
TELEGRAM_PUBLISH_BATCH_SIZE=10
TELEGRAM_PUBLISH_MAX_ATTEMPTS=3
JOBHUB_PUBLIC_BASE_URL=http://localhost:5173

# Private server-side storage. Mount this path to a persistent private volume in deployment.
RESUME_STORAGE_DIR=./storage/resumes
# On serverless, use a private Supabase Storage bucket named "resumes" instead.
# Never set the secret key in VITE_* variables or commit its real value.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
